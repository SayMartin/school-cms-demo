BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maintenance report recipients: IT issues -> INCIDENT_EMAIL, other (facilities) -> FASTIGHET_EMAIL.
# ADMIN_EMAIL is used as a fallback if the category-specific ones are missing.
# For testing: incident@ goes to the IT contact.
INCIDENT_EMAIL=incident@example.com
FASTIGHET_EMAIL=facilities@example.com
ADMIN_EMAIL=admin@example.com

DATABASE_URL=

NEXTJS_ENV=development

# Cloudflare Turnstile — testnycklar som alltid godkänns i dev
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SENDER_EMAIL=

MOTESPLATS_EMAIL=