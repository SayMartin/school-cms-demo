{
  "name": "school-cms-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "preview:remote": "opennextjs-cloudflare build && opennextjs-cloudflare preview -- --remote",
    "deploy": "opennextjs-cloudflare deploy -- --minify",
    "db:migrate:local": "wrangler d1 migrations apply school-cms-demo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply school-cms-demo-db --remote",
    "db:seed:demo:local": "wrangler d1 execute school-cms-demo-db --local --file scripts/seed-demo-data.sql",
    "db:seed:demo:remote": "wrangler d1 execute school-cms-demo-db --remote --file scripts/seed-demo-data.sql",
    "db:seed:instances:local": "wrangler d1 execute school-cms-demo-db --local --file scripts/seed-course-instances.sql",
    "db:seed:instances:remote": "wrangler d1 execute school-cms-demo-db --remote --file scripts/seed-course-instances.sql",
    "seed:demo-users:local": "node scripts/seed-demo-users.mjs --local",
    "seed:demo-users:remote": "node scripts/seed-demo-users.mjs --remote"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "better-auth": "^1.6.20",
    "drizzle-orm": "^0.45.2",
    "html-react-parser": "^6.1.3",
    "lucide-react": "^1.21.0",
    "next": "^16.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
