{
	// Cloudflare Workers / Pages configuration
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	// DEMO COPY — separate Cloudflare account, separate D1/R2. No connection to
	// any real production project or real school's infrastructure. This is the
	// "School CMS Demo" project; "Demo Folk High School" here is just the
	// example implementation's fictional content, not a real school.
	"name": "school-cms-demo",
	// account_id intentionally omitted from version control — wrangler
	// auto-selects it if your API token only has access to one account;
	// otherwise add your own "account_id": "..." here locally (untracked).
	"compatibility_date": "2026-02-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": ".open-next/worker.js",
	"workers_dev": false,
	"preview_urls": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	// Non-secret runtime config — auth secret is set via `wrangler secret put BETTER_AUTH_SECRET`
	"vars": {
		"APP_ENV": "dev",
		// Blocks destructive admin actions, public sign-up, and course-application
		// submission/upload at the API layer, regardless of which demo account is
		// used to log in. See src/lib/auth/demo-lock.ts for the guarded endpoints.
		// Set to "false" to re-enable for a non-public deployment.
		"DEMO_LOCKDOWN": "true",
		"BETTER_AUTH_URL": "https://school-cms-demo.appfinningar.se",
		"NEXT_PUBLIC_APP_URL": "https://school-cms-demo.appfinningar.se",
		// Cloudflare Turnstile test keys — always pass, no real widget registration
		// needed. The secret is a published test value, not a credential, so it lives
		// here rather than in `wrangler secret`. Nothing reaches Turnstile today: all
		// the public forms are inert (see src/lib/auth/demo-lock.ts), so the widget is
		// rendered nowhere. These are kept, and the server checks kept fail-closed, so
		// that a non-demo deployment has a working path — swap in real keys there.
		"TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
		// Demo addresses — sending is fully mocked in src/lib/email/client.ts
		// anyway; this is just defense-in-depth so nothing points at a real domain.
		"INCIDENT_EMAIL": "incident@example.com",
		"FASTIGHET_EMAIL": "fastighet@example.com",
		"ADMIN_EMAIL": "admin@example.com",
		"GOOGLE_SENDER_EMAIL": "noreply@example.com",
		"MOTESPLATS_EMAIL": "motesplats@example.com",
		"ANSOKAN_EMAIL": "ansokan@example.com",
	},
	// D1 — separate demo database, empty to start, filled with invented data
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "school-cms-demo-db",
			"database_id": "46787978-992e-428a-ad41-e958033510df",
			"migrations_dir": "drizzle/migrations",
		},
	],
	// DEMO COPY: no production environment exists in this configuration. There
	// is nowhere for a deploy:prod or migrate:prod to go — impossible to
	// accidentally hit a real domain or real prod D1/R2.
	"env": {},
	// Rate limiting. The Studio password is public, so every privileged write
	// path is effectively a public one — these caps are what stands between a
	// bored visitor and a filled database or an R2 bill. namespace_id is a
	// per-Worker identifier chosen here, not a resource to create in the
	// dashboard; the counters are per-colo and store nothing readable, which is
	// why /privacy can still say no visitor data is kept.
	"ratelimits": [
		{
			// Sign-in and the other credential endpoints. Better Auth's own limiter
			// is inert now that IP tracking is off (it skips the check when it
			// cannot resolve an address), so this replaces it.
			"name": "AUTH_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60,
			},
		},
		{
			// Uploads into R2. The tightest cap: one request here can cost 200 MB.
			"name": "UPLOAD_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60,
			},
		},
		{
			// Every other authenticated mutation — the Studio and portal CRUD
			// endpoints. Loose enough that ordinary editing never notices it.
			"name": "WRITE_LIMITER",
			"namespace_id": "1003",
			"simple": {
				"limit": 60,
				"period": 60,
			},
		},
	],
	// R2 — separate demo bucket
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "school-cms-demo-bucket",
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1, // optional. default = 1.
	},
}